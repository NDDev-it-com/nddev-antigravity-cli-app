{
  "contract_version": 2,
  "product_name": "nddev-antigravity-cli-app",
  "display_name": "NDDev Antigravity CLI Setup Manager",
  "github_repository": "NDDev-it-com/nddev-antigravity-cli-app",
  "license": "AGPL-3.0-or-later",
  "description": "Dependency-free manager that installs, switches, migrates, restores, and removes one Antigravity CLI content setup plus one orthogonal permission profile in an explicit isolated HOME target.",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_roots": {
    "setups": "setups",
    "profiles": "profiles"
  },
  "setup_system": {
    "catalog_root": "setups",
    "profile_root": "profiles",
    "content_setup_ids": [
      "nddev-builder"
    ],
    "default_setup_id": "nddev-builder",
    "permission_profile_ids": [
      "full-auto",
      "safe"
    ],
    "default_permission_profile_id": "full-auto",
    "setup_option": "--setup <id>",
    "profile_option": "--profile <id>",
    "list_command": "python3 cli-tools/nddev_antigravity_cli.py list [--json]",
    "status_command": "python3 cli-tools/nddev_antigravity_cli.py status --target <absolute-home-target> [--json]",
    "plan_command": "python3 cli-tools/nddev_antigravity_cli.py plan [--setup nddev-builder] [--profile full-auto|safe] --target <absolute-home-target> [--json]",
    "install_command": "python3 cli-tools/nddev_antigravity_cli.py install [--setup nddev-builder] [--profile full-auto|safe] --target <absolute-home-target> [--json]",
    "switch_command": "python3 cli-tools/nddev_antigravity_cli.py switch [--setup nddev-builder] [--profile full-auto|safe] --target <absolute-home-target> [--json]",
    "migrate_command": "python3 cli-tools/nddev_antigravity_cli.py migrate [--setup nddev-builder] [--profile full-auto|safe] --target <absolute-home-target> [--json]",
    "restore_command": "python3 cli-tools/nddev_antigravity_cli.py restore --backup <0..9> --target <absolute-home-target> [--json]",
    "remove_command": "python3 cli-tools/nddev_antigravity_cli.py remove --target <absolute-home-target> [--json]",
    "plan_mutates": false
  },
  "software_install": {
    "supported": true,
    "mechanism": "official-antigravity-install-manifest",
    "official_source": "https://antigravity.google/cli/install.sh",
    "command": "agy",
    "version": "1.1.7",
    "managed_command": "bin/agy",
    "status_command": "python3 cli-tools/nddev_antigravity_cli.py software-status --target <absolute-home-target> [--json]",
    "install_command": "python3 cli-tools/nddev_antigravity_cli.py install-cli --target <absolute-home-target> [--json]",
    "update_command": "python3 cli-tools/nddev_antigravity_cli.py update-cli --target <absolute-home-target> [--json]",
    "status_fields": [
      "installed",
      "current",
      "drift"
    ],
    "install_precondition": "absent managed software",
    "update_precondition": "existing managed software",
    "update_current_behavior": "idempotent no-op without downloading",
    "stage_and_atomic_swap": true,
    "rollback_on_failure": true,
    "artifact_reader": "bounded single-member tar extraction; rejects traversal, symlink, hardlink, and device candidates",
    "artifact_pin_fields": [
      "version",
      "url",
      "sha512"
    ],
    "installer_url": "https://antigravity.google/cli/install.sh",
    "manifest_url_template": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/{platform}.json",
    "npm": null,
    "pip": null
  },
  "managed_state": {
    "target_model": "isolated-home",
    "settings_file": ".gemini/antigravity-cli/settings.json",
    "stamp_file": "NDDEV-ANTIGRAVITY-CLI-SETUP.json",
    "stamp_schema": 2,
    "legacy_stamp_schema": 1,
    "backup_slots": 10,
    "managed_file_mode": "0600",
    "new_target_mode": "0700",
    "managed_files": [
      ".gemini/antigravity-cli/settings.json",
      ".gemini/antigravity-cli/plugins/nddev-builder/plugin.json",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-builder/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-builder/references/native-surfaces.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-builder/references/source-owners.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-builder/references/validation-workflows.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-config/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-permissions/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-agents/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-instructions/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-plugins/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-hooks/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-mcp/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-lifecycle/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/skills/nddev-antigravity-validation/SKILL.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/agents/nddev-builder.md",
      ".gemini/antigravity-cli/plugins/nddev-builder/rules/nddev-builder.md"
    ],
    "managed_settings_keys": [
      "toolPermission",
      "artifactReviewPolicy",
      "enableTerminalSandbox",
      "allowNonWorkspaceAccess",
      "permissions"
    ],
    "preserve_other_state": true,
    "legacy_allowed_commands": [
      "status",
      "migrate",
      "restore",
      "remove"
    ],
    "legacy_launch_denied": true
  },
  "builder": {
    "id": "nddev-builder",
    "projection": "native-plugin",
    "marketplace": null,
    "status": "default-on",
    "native_surfaces": {
      "plugin_manifest": ".gemini/antigravity-cli/plugins/nddev-builder/plugin.json",
      "skills": ".gemini/antigravity-cli/plugins/nddev-builder/skills/",
      "agents": ".gemini/antigravity-cli/plugins/nddev-builder/agents/",
      "rules": ".gemini/antigravity-cli/plugins/nddev-builder/rules/",
      "hooks": null,
      "mcp": null
    },
    "default_hooks": false,
    "default_mcp_servers": false,
    "managed_files_ref": "build/manifest.json:builder.managed_files",
    "enabled_in_setups": [
      "nddev-builder"
    ]
  },
  "runtime_launch": {
    "executable": "agy",
    "managed_executable": "bin/agy",
    "manager_command": "python3 cli-tools/nddev_antigravity_cli.py launch --target <absolute-home-target> -- [args...]",
    "direct_command": null,
    "requires_clean_managed_target": true,
    "requires_current_target_owned_software": true,
    "target_lock_held_through_child": true,
    "target_lock_mechanism": "persistent-target-internal-flock-file",
    "authoritative_lock_mechanism": "external-bootstrap-flock-file",
    "external_lock_binding": "product-namespaced-sha256-canonical-target-json",
    "external_lock_persistent": true,
    "external_lock_exposed_to_child": false,
    "target_internal_lock_role": "target-local-state",
    "immediate_executable_digest_recheck": true,
    "executable_handoff": "write-protected-verified-path",
    "protected_path_scope": "lock-and-artifact-directories-only",
    "runtime_state_writable_during_child": true,
    "portable_fd_execution": false,
    "same_uid_chmod_resistance": false,
    "lifecycle_mutations_blocked_while_child_runs": true,
    "legacy_launch_denied": true,
    "path_fallback": false,
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "target_environment_scope": "child-process-only",
    "credential_env_inherited": false,
    "managed_override_args_blocked": [
      "--sandbox",
      "--dangerously-skip-permissions",
      "--permission-mode",
      "--mode",
      "--cwd",
      "--agent"
    ],
    "successful_child_output_wrapped": false
  },
  "safety": {
    "absolute_target_required": true,
    "default_target": null,
    "relative_target_rejected": true,
    "target_symlinks_rejected": true,
    "canonical_target_binding": true,
    "preserve_unmanaged_files": true,
    "preserve_unmanaged_settings_keys": true,
    "reject_symlink_managed_files": true,
    "reject_hardlinked_managed_files": true,
    "rollback_on_failure": true,
    "bounded_reads": true,
    "max_backups": 10,
    "backup_pool_location": ".nddev-antigravity-cli-backups",
    "backup_pool_lock": ".nddev-antigravity-cli-backups-lock",
    "target_lock": ".nddev-antigravity-cli-lock"
  },
  "runtime_compatibility": {
    "product": "Antigravity CLI",
    "version_ref": "build/version.json",
    "baseline_ref": "references/antigravity-cli-baseline.json",
    "official_source": {
      "repository": "https://github.com/google-antigravity/antigravity-cli",
      "docs": "https://antigravity.google/docs/cli/overview"
    },
    "official_docs": {
      "overview": "https://antigravity.google/docs/cli/overview",
      "install": "https://antigravity.google/docs/cli/install",
      "settings": "https://antigravity.google/docs/cli/settings",
      "permissions": "https://antigravity.google/docs/cli/permissions",
      "sandbox": "https://antigravity.google/docs/cli/sandbox",
      "plugins": "https://antigravity.google/docs/cli/plugins",
      "skills": "https://antigravity.google/docs/skills",
      "agents": "https://antigravity.google/docs/subagents",
      "rules": "https://antigravity.google/docs/rules-workflows",
      "hooks": "https://antigravity.google/docs/hooks",
      "mcp": "https://antigravity.google/docs/mcp",
      "reference": "https://antigravity.google/docs/cli/reference"
    }
  }
}
